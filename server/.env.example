# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (production: your real domain)
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL via Prisma) ───────────────────────────────────────
# Local dev default matches docker-compose.yml. Format:
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://gbl:gbl_dev_password@localhost:5432/gbl80s?schema=public

# ─── Authentication (Phase 3 — document now, wire up later) ────────────────
# Generate with: openssl rand -hex 32
# JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=30

# ─── Object storage (S3-compatible; Phase 5 uploads) ───────────────────────
# Local dev default matches docker-compose.yml (MinIO).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=gbl80s-media
# S3_ACCESS_KEY=gbl_minio
# S3_SECRET_KEY=gbl_minio_secret
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# ─── Email / notifications (Phase 6+, optional in v1) ──────────────────────
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=archive@example.com
